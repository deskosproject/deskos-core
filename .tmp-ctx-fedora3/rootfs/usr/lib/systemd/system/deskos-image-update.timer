# Generated by deskosctl. Do not edit; change the DeskOS resources instead.
[Unit]
Description=Download and stage the next image without rebooting (daily)
Documentation=man:bootc-upgrade(8)

[Timer]
OnCalendar=daily
RandomizedDelaySec=2h
Persistent=true
Unit=deskos-image-update.service

[Install]
WantedBy=timers.target
