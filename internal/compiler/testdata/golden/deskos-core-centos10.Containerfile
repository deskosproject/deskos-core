# Generated by deskosctl from plan.json. Do not edit.
#
# Workstation: deskos-core-centos10
# Platform:    centos-stream-10 (CentOS Stream 10)

FROM quay.io/centos-bootc/centos-bootc:stream10@sha256:98cb998076992ed9052a7a989a7e8df3d1774a02c37bce7dec05ba8e3242f726

# Package groups
RUN --mount=type=tmpfs,target=/var/lib/rhsm \
    --mount=type=tmpfs,target=/var/log/rhsm \
    if [ -e /etc/yum.repos.d/redhat.repo ]; then echo 'refusing to run dnf: /etc/yum.repos.d/redhat.repo already exists' >&2; exit 1; fi \
    && dnf -y group install \
        '--exclude=setroubleshoot' \
        '--exclude=setroubleshoot-plugins' \
        '--exclude=setroubleshoot-server' \
        'workstation-product-environment' \
    && dnf clean all \
    && rm -f /etc/yum.repos.d/redhat.repo

# Packages
RUN --mount=type=tmpfs,target=/var/lib/rhsm \
    --mount=type=tmpfs,target=/var/log/rhsm \
    if [ -e /etc/yum.repos.d/redhat.repo ]; then echo 'refusing to run dnf: /etc/yum.repos.d/redhat.repo already exists' >&2; exit 1; fi \
    && dnf -y install \
        'NetworkManager' \
        'bootc' \
        'firefox' \
        'firewalld' \
        'flatpak' \
        'xdg-utils' \
    && dnf clean all \
    && rm -f /etc/yum.repos.d/redhat.repo

# Image files
COPY rootfs/ /

# System configuration
RUN dconf update \
    && systemctl enable 'deskos-flatpak-preinstall.service' 'deskos-flatpak-update.timer' 'deskos-image-update.timer' 'firewalld.service' 'gdm.service' \
    && systemctl mask 'bootc-fetch-apply-updates.service' 'bootc-fetch-apply-updates.timer' \
    && systemctl set-default 'graphical.target'

# Cleanup and bootc validation
RUN rm -rf /var/cache/dnf /var/cache/libdnf5 /var/lib/dnf/repos /var/log/dnf* /var/log/hawkey.log /tmp/* /var/tmp/* \
    && bootc container lint

LABEL org.deskos.platform="centos-stream-10" \
      org.deskos.workstation="deskos-core-centos10" \
      org.opencontainers.image.title="DeskOS Core (CentOS Stream 10)"
