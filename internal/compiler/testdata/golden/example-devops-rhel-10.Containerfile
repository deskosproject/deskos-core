    for kdir in /usr/lib/modules/*/; do \
        [ -e "${kdir}vmlinuz" ] || continue; \
        kver="$(basename "$kdir")"; \
        env DRACUT_NO_XATTR=1 dracut --force --no-hostonly "${kdir}initramfs.img" "$kver"; \
