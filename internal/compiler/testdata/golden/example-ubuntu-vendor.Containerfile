FROM quay.io/deskos/deskos-ubuntu-base:26.04@sha256:ec5ce29551fdc9f311aef5c5fa82d147727416bce0fa757f5f272fd8c53303f2

# Package repositories
COPY repos/ /

# Package groups
RUN \
    apt-get update \
    && apt-get -y install \
        'ubuntu-desktop-minimal' \
        'curl' \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Packages
RUN \
    apt-get update \
    && apt-get -y install \
        'code' \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Binary artifact deskos 0.12.0 (sha256-verified)
RUN set -eu; \
    tmp="$(mktemp -d)"; \
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
        -o "$tmp/download" 'https://github.com/deskosproject/deskos-core/releases/download/v0.12.0/deskos-v0.12.0-linux-amd64'; \
    echo '715419b664be5e9c1144f94306a985155dade72f613c83ca96150272a223b390  '"$tmp/download" | sha256sum --check --strict --quiet -; \
    mkdir -p "$(readlink -m "$(dirname '/usr/local/bin/deskos')")"; \
    install -D -m 0755 "$tmp/download" '/usr/local/bin/deskos'; \
    rm -rf "$tmp"

# Image files
COPY rootfs/ /

# System configuration
RUN systemctl enable 'deskos-image-update.timer' 'gdm.service' \
    && systemctl mask 'bootc-fetch-apply-updates.service' 'bootc-fetch-apply-updates.timer' \
    && systemctl set-default 'graphical.target'

# Cleanup and bootc validation
RUN rm -rf /var/cache/apt /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && bootc container lint

