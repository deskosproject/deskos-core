FROM quay.io/deskos/deskos-ubuntu-base:26.04@sha256:0ef21d0691c298a1e2d7d8737807ff9d9bf384784bc545fa816f8b5dca0c1fc5

# Package groups
RUN \
    apt-get update \
    && apt-get -y install \
        'ubuntu-desktop-minimal' \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Image files
COPY rootfs/ /

# System configuration
RUN dconf update \
    && systemctl enable 'deskos-image-update.timer' 'gdm.service' \
    && systemctl mask 'bootc-fetch-apply-updates.service' 'bootc-fetch-apply-updates.timer' \
    && systemctl set-default 'graphical.target'

# Cleanup and bootc validation
RUN rm -rf /var/cache/apt /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && bootc container lint

LABEL org.deskos.platform="ubuntu-2604" \
      org.deskos.workstation="deskos-core-ubuntu2604" \
