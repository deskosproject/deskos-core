{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskos.org/schemas/system.deskos.org/v1alpha1/bootprofile.json",
  "title": "system.deskos.org/v1alpha1 BootProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "system.deskos.org/v1alpha1" },
    "kind": { "const": "BootProfile" },
    "metadata": { "$ref": "../../common/metadata.json" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "splash": { "enum": ["graphical", "text"] },
        "quiet": { "type": "boolean" },
        "watermark": { "$ref": "../../common/definitions.json#/$defs/relativePath" }
      }
    }
  }
}
