{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskos.org/schemas/desktop.deskos.org/v1alpha1/gnomeprofile.json",
  "title": "desktop.deskos.org/v1alpha1 GnomeProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "desktop.deskos.org/v1alpha1" },
    "kind": { "const": "GnomeProfile" },
    "metadata": { "$ref": "../../common/metadata.json" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "proxyServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$|^[0-9A-Fa-f:]+$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults"],
      "properties": {
        "defaults": { "$ref": "#/$defs/settings" },
        "locks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": [
            "windows.buttons", "windows.buttonPlacement",
            "appearance.wallpaper", "appearance.loginLogo", "appearance.lockShield",
            "appearance.fonts.interface", "appearance.fonts.document", "appearance.fonts.monospace",
            "appearance.fonts.titlebar", "appearance.fonts.terminal", "appearance.fonts.textScaling",
            "appearance.fonts.antialiasing", "appearance.fonts.hinting",
            "appearance.fonts.rgbaOrder", "appearance.fonts.lcdfilter",
            "appearance.iconTheme", "appearance.cursorTheme",
            "appearance.colorScheme", "appearance.accentColor",
            "shell.favorites",
            "session.idle.blankAfter", "session.idle.dim", "session.idle.dimBrightness",
            "session.lock.enabled", "session.lock.delay",
            "login.showUserList", "login.banner",
            "shell.extensions",
            "dock.position", "dock.behavior", "dock.iconSize", "dock.showTrash",
            "software.updates",
            "shell.hotCorners", "shell.welcomeTour", "shell.workspaces", "shell.appFolders",
            "shell.developmentTools",
            "clock.showWeekday", "clock.format",
            "keyboard.numLock", "keyboard.terminal", "keyboard.layouts", "keyboard.xkbOptions",
            "network.proxy.mode", "network.proxy.autoconfigUrl", "network.proxy.ignoreHosts",
            "network.proxy.useSameProxy", "network.proxy.http", "network.proxy.https",
            "network.proxy.ftp", "network.proxy.socks",
            "privacy.rememberRecentFiles", "privacy.recentFilesMaxAge", "privacy.rememberAppUsage",
            "privacy.removeOldTempFiles", "privacy.removeOldTrashFiles", "privacy.oldFilesAge",
            "privacy.reportTechnicalProblems", "privacy.sendSoftwareUsageStats", "privacy.disableCamera",
            "privacy.disableMicrophone", "privacy.disableSoundOutput", "privacy.hideIdentity",
            "privacy.privacyScreen",
            "power.buttonAction",
            "lockdown.disablePrinting", "lockdown.disablePrintSetup",
            "lockdown.disableSaveToDisk", "lockdown.disableLogOut",
            "lockdown.disableUserSwitching", "lockdown.disableApplicationHandlers",
            "lockdown.disableCommandLine", "lockdown.disableShowPassword",
            "lockdown.disableLockScreen", "lockdown.mountRemovableStorageReadOnly",
            "lockdown.disableUserAdministration"
          ] }
        }
      }
    },
    "desktopId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.desktop$" },
    "extensionUUID": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "duration": { "type": "string", "pattern": "^([0-9]+(h|m|s))+$" },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "size"],
      "properties": {
        "family": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*$" },
        "size": { "type": "number", "minimum": 6, "maximum": 72 }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windows": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buttons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["minimize", "maximize", "close"] } },
            "buttonPlacement": { "enum": ["left", "right"] }
          }
        },
        "applications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "browser": { "$ref": "#/$defs/desktopId" },
            "fileManager": { "$ref": "#/$defs/desktopId" },
            "textEditor": { "$ref": "#/$defs/desktopId" },
            "imageViewer": { "$ref": "#/$defs/desktopId" },
            "videoPlayer": { "$ref": "#/$defs/desktopId" },
            "pdfViewer": { "$ref": "#/$defs/desktopId" }
          }
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wallpaper": {
              "type": "object",
              "additionalProperties": false,
              "required": ["light"],
              "properties": {
                "light": { "$ref": "../../common/definitions.json#/$defs/relativePath" },
                "dark": { "$ref": "../../common/definitions.json#/$defs/relativePath" }
              }
            },
            "fonts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "interface": { "$ref": "#/$defs/font" },
                "document": { "$ref": "#/$defs/font" },
                "monospace": { "$ref": "#/$defs/font" },
                "titlebar": { "$ref": "#/$defs/font" },
                "terminal": { "$ref": "#/$defs/font" },
                "textScaling": { "type": "number", "minimum": 0.5, "maximum": 3, "description": "GNOME's text-scaling-factor: a multiplier over every size, not a size." },
                "antialiasing": { "enum": ["none", "grayscale", "rgba"] },
                "hinting": { "enum": ["none", "slight", "medium", "full"] },
                "rgbaOrder": { "enum": ["rgb", "bgr", "vrgb", "vbgr"] },
                "lcdfilter": { "enum": ["none", "default", "light", "legacy"] }
              }
            },
            "loginLogo": { "$ref": "../../common/definitions.json#/$defs/relativePath" },
            "lockShield": { "$ref": "../../common/definitions.json#/$defs/relativePath" },
            "iconTheme": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+-]*$" },
            "cursorTheme": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+-]*$" },
            "colorScheme": { "enum": ["default", "prefer-dark", "prefer-light"] },
            "accentColor": { "enum": ["blue", "teal", "green", "yellow", "orange", "red", "pink", "purple", "slate"] }
          }
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "developmentTools": { "type": "boolean" },
            "favorites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/desktopId" } },
            "hotCorners": { "type": "boolean" },
            "welcomeTour": { "type": "boolean" },
            "workspaces": { "anyOf": [{ "const": "dynamic" }, { "type": "integer", "minimum": 1, "maximum": 36 }] },
            "appFolders": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name"],
                "anyOf": [{ "required": ["apps"] }, { "required": ["categories"] }],
                "properties": {
                  "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
                  "name": { "$ref": "../../common/definitions.json#/$defs/singleLine", "minLength": 1 },
                  "apps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/desktopId" } },
                  "categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" } }
                }
              }
            },
            "extensions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["uuid", "enabled"],
                "properties": {
                  "uuid": { "$ref": "#/$defs/extensionUUID" },
                  "enabled": { "type": "boolean" }
                }
              }
            }
          }
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buttonAction": { "enum": ["nothing", "suspend", "hibernate", "interactive"] }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "proxy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "enum": ["none", "auto", "manual"] },
                "autoconfigUrl": { "type": "string", "pattern": "^https?://[^\\s]+$", "description": "The PAC file, read only when mode is auto." },
                "ignoreHosts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[^\\s]+$" } },
                "useSameProxy": { "type": "boolean", "description": "GNOME uses the HTTP proxy for every protocol unless this is false; declaring https, ftp or socks turns it off when the field is absent." },
                "http": { "$ref": "#/$defs/proxyServer" },
                "https": { "$ref": "#/$defs/proxyServer" },
                "ftp": { "$ref": "#/$defs/proxyServer" },
                "socks": { "$ref": "#/$defs/proxyServer" }
              }
            }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rememberRecentFiles": { "type": "boolean" },
            "recentFilesMaxAge": { "type": "integer", "minimum": -1, "description": "Days; -1 keeps every recent file, 0 keeps none." },
            "rememberAppUsage": { "type": "boolean" },
            "removeOldTempFiles": { "type": "boolean" },
            "removeOldTrashFiles": { "type": "boolean" },
            "oldFilesAge": { "type": "integer", "minimum": 1, "maximum": 3650, "description": "Days after which old temp and trash files are removed." },
            "reportTechnicalProblems": { "type": "boolean" },
            "sendSoftwareUsageStats": { "type": "boolean" },
            "disableCamera": { "type": "boolean" },
            "disableMicrophone": { "type": "boolean" },
            "disableSoundOutput": { "type": "boolean" },
            "hideIdentity": { "type": "boolean" },
            "privacyScreen": { "type": "boolean" }
          }
        },
        "login": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "showUserList": { "type": "boolean" },
            "banner": { "type": "string" }
          }
        },
        "lockdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "disablePrinting": { "type": "boolean" },
            "disablePrintSetup": { "type": "boolean" },
            "disableSaveToDisk": { "type": "boolean" },
            "disableLogOut": { "type": "boolean" },
            "disableUserSwitching": { "type": "boolean" },
            "disableApplicationHandlers": { "type": "boolean" },
            "disableCommandLine": { "type": "boolean" },
            "disableShowPassword": { "type": "boolean" },
            "disableLockScreen": { "type": "boolean" },
            "mountRemovableStorageReadOnly": { "type": "boolean" },
            "disableUserAdministration": { "type": "boolean" }
          }
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "showWeekday": { "type": "boolean" },
            "format": { "enum": ["24h", "12h"] }
          }
        },
        "keyboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numLock": { "type": "boolean" },
            "terminal": { "$ref": "#/$defs/desktopId" },
            "layouts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["layout"],
                "properties": {
                  "layout": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "An xkb layout name, for example us, es or latam. The first layout is the one a session starts in." },
                  "variant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$", "description": "An xkb variant of that layout, for example intl or nodeadkeys." }
                }
              }
            },
            "xkbOptions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": [
                "caps:none", "compose:caps", "compose:menu", "compose:ralt",
                "compose:rctrl", "ctrl:nocaps", "grp:alt_shift_toggle"
              ] }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "blankAfter": { "anyOf": [{ "const": "never" }, { "$ref": "#/$defs/duration" }] },
                "dim": { "type": "boolean" },
                "dimBrightness": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            },
            "lock": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "delay": { "$ref": "#/$defs/duration" }
              }
            }
          }
        },
        "dock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position": { "enum": ["bottom", "left", "right", "top"] },
            "behavior": { "enum": ["fixed", "autohide", "intellihide"] },
            "iconSize": { "type": "integer", "minimum": 16, "maximum": 64 },
            "showTrash": { "type": "boolean" }
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "updates": { "enum": ["automatic", "manual", "disabled"] }
          }
        }
      }
    }
  }
}
