{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskos.org/schemas/common/metadata.json",
  "title": "DeskOS resource metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    }
  }
}
