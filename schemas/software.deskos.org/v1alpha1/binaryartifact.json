{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskos.org/schemas/software.deskos.org/v1alpha1/binaryartifact.json",
  "title": "software.deskos.org/v1alpha1 BinaryArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "software.deskos.org/v1alpha1" },
    "kind": { "const": "BinaryArtifact" },
    "metadata": { "$ref": "../../common/metadata.json" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "archive", "files"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": { "$ref": "../../common/definitions.json#/$defs/httpsURL" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "archive": { "enum": ["none", "tar.gz"] },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["destination"],
            "properties": {
              "path": { "$ref": "../../common/definitions.json#/$defs/relativePath" },
              "destination": {
                "type": "string",
                "pattern": "^(/usr/local/bin/[A-Za-z0-9][A-Za-z0-9._+-]*|/usr/local/share/fonts/[A-Za-z0-9][A-Za-z0-9._+-]*\\.(ttf|otf|ttc|txt)|/usr/bin/deskos)$",
                "description": "A binary lands under /usr/local/bin, which belongs to no package. The one exception is the runtime companion at /usr/bin/deskos, named here so sudo's secure_path finds it (ADR 0018). A font lands under /usr/local/share/fonts, which fontconfig reads and no package owns; a text file beside it carries the licence (ADR 0018, amended 2026-10-29)."
              },
              "mode": { "enum": ["0444", "0555", "0644", "0755"], "description": "0755 or 0555 for an executable, 0644 or 0444 for a font; the decoder pairs the mode with the destination." }
            }
          }
        },
        "desktopEntry": { "$ref": "#/$defs/desktopEntry" }
      }
    },
    "desktopEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "icon", "categories"],
      "properties": {
        "id": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)+$" },
        "name": { "$ref": "../../common/definitions.json#/$defs/singleLine", "minLength": 1 },
        "comment": { "$ref": "../../common/definitions.json#/$defs/singleLine" },
        "icon": { "$ref": "../../common/definitions.json#/$defs/relativePath" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9]+$" }
        },
        "startupWMClass": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    }
  }
}
