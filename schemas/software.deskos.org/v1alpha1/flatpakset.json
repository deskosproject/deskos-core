{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskos.org/schemas/software.deskos.org/v1alpha1/flatpakset.json",
  "title": "software.deskos.org/v1alpha1 FlatpakSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "software.deskos.org/v1alpha1" },
    "kind": { "const": "FlatpakSet" },
    "metadata": { "$ref": "../../common/metadata.json" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "applications"],
      "properties": {
        "remote": { "$ref": "../../common/definitions.json#/$defs/name" },
        "applications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*){2,}$" },
              "branch": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
            }
          }
        }
      }
    }
  }
}
