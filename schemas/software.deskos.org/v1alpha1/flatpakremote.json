{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskos.org/schemas/software.deskos.org/v1alpha1/flatpakremote.json",
  "title": "software.deskos.org/v1alpha1 FlatpakRemote",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "software.deskos.org/v1alpha1" },
    "kind": { "const": "FlatpakRemote" },
    "metadata": { "$ref": "../../common/metadata.json" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "gpgKeyFile"],
      "properties": {
        "title": { "$ref": "../../common/definitions.json#/$defs/singleLine", "minLength": 1 },
        "url": { "$ref": "../../common/definitions.json#/$defs/httpsURL" },
        "homepage": { "$ref": "../../common/definitions.json#/$defs/httpsURL" },
        "comment": { "$ref": "../../common/definitions.json#/$defs/singleLine" },
        "description": { "$ref": "../../common/definitions.json#/$defs/singleLine" },
        "collectionID": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)+$" },
        "gpgKeyFile": { "$ref": "../../common/definitions.json#/$defs/relativePath" }
      }
    }
  }
}
