{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskos.org/schemas/core.deskos.org/v1alpha1/workstation.json",
  "title": "core.deskos.org/v1alpha1 Workstation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "core.deskos.org/v1alpha1" },
    "kind": { "const": "Workstation" },
    "metadata": { "$ref": "../../common/metadata.json" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformRef", "profiles"],
      "properties": {
        "displayName": { "$ref": "../../common/definitions.json#/$defs/singleLine" },
        "platformRef": { "$ref": "../../common/definitions.json#/$defs/name" },
        "profiles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "../../common/definitions.json#/$defs/name" }
        }
      }
    }
  }
}
