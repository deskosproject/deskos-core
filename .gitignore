/bin/
/dist/
/output/

# Disk images and build outputs
*.qcow2
*.raw
*.iso
*.img
*.tar

# Local credentials never belong in the repository
.env
.env.*
*.pem
*.key

# Python bytecode from the VM harness tests
__pycache__/
/tmp-ctx/
# Contexts a local render leaves in the repository root. Renovate used to bump
# their Containerfile pins, which changed nothing that ships.
/.tmp-ctx*/
# Evidence scratch trees from a VM run; the harness writes them next to the
# repository, and a `git add -A` once captured one.
/.tmp-ev-*/

# Go toolchain telemetry and build cache, written by the container used for tests.
.config/
.cache/
